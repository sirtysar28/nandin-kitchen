# ============================================================
# Nandin Kitchen — Proteksi folder API
# ============================================================

# Jangan tampilkan daftar file
Options -Indexes

# Blokir akses langsung ke file konfigurasi (berisi password database)
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
